<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lyrical</RootNamespace>
    <AssemblyName>Lyrical</AssemblyName>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
     <Using Include="System.IO" />
     <Using Include="System.Linq" />
     <Using Include="System.Collections.Generic" />
     <Using Include="System.Net.Http" />
     <Using Include="System.Threading" />
     <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <!-- Ship the web renderer next to the exe as a "web" folder. -->
  <ItemGroup>
    <Content Include="..\..\web\**\*" Exclude="..\..\web\**\*.test.js" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\providers\betterlyrics\worker.py" Link="providers\betterlyrics\worker.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
